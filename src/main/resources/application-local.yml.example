# ============================================================
# 本地配置模板
# 使用方法：复制本文件为 application-local.yml，填入你自己的值。
# application-local.yml 已被 .gitignore 忽略，不会提交到仓库。
# ============================================================
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/inventory_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
    username: root
    password: "你的 MySQL 密码"

  mail:
    # QQ 邮箱需在「设置-账户」中开启 SMTP 并获取授权码（不是登录密码）
    username: "你的邮箱@qq.com"
    password: "你的邮箱授权码"

ai:
  api:
    # 火山方舟 API Key
    key: "你的 API Key"

tesseract:
  # OCR 语言包目录，可选
  datapath: D:/Tesseract-OCR/tessdata
